/target
**/*.rs.bk
*.pending-snap

# Proprietary design docs — local only, never published. `docs/*` rather
# than `docs/` so that the two published documents below can be negated:
# git will not re-include a file whose parent directory is excluded.
docs/*
!docs/tutorial.md
!docs/reference.md

# Local permission settings, not part of the project
.claude/

# The VS Code extension's language client, installed with `npm install`
node_modules/
package-lock.json

# Python bytecode, from running the scripts in `scripts/`.
__pycache__/
*.pyc

# `zdc build` writes here by default, so a bundle built while working on an
# example lands in the repository root looking like source.
/dist

# Screenshots and console logs from driving a built program in a real
# browser. `crates/zdc-cli/tests/browser.rs` and the Playwright MCP both
# write here; 2.1 MB of them reached a commit once, through a `git add -A`
# that was meant for source.
/.playwright-mcp/
/*.png

# The playground's WebAssembly module, when it has been copied beside the
# page. `README.md` says to do that for a deployment, and it is a build
# artefact of `zdc-wasm` either way — 2.7 MB of it.
/playground/*.wasm
