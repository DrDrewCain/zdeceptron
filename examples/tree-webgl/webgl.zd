# webgl.zd — the same tree, drawn by real three.js, with no JavaScript
# beside it.
#
# `examples/tree/` draws a tree out of nested CSS transforms and ships no
# JavaScript at all. This one ships none either, and the renderer is
# WebGL: every line below is ZDeceptron, three.js arrives through
# `zd.toml`'s `[packages]` map, and there is no adapter module in between.
#
# The two examples are not a replacement for each other. CSS 3D composes
# transforms in the compositor and needs no library at all, which is why
# it is the better answer at the sizes it reaches; it stops at a few
# hundred branches, because every one of them is two DOM elements inside a
# `preserve-3d` subtree and none of them can be flattened into a layer.
# WebGL instances thousands without noticing.
#
# WHAT THIS EXAMPLE IS FOR, WHICH IS THE LIFETIME. `draw.js` — the
# hand-written module both these examples used to need — kept a
# `mount`/`update` split, and its own comment says why: a WebGL context is
# not cheap, a browser will only give a page so many, and re-acquiring one
# on every slider move leaks contexts until the oldest are force-reclaimed
# and the canvas goes blank.
#
# That split is now the difference between two words in this language.
#
#   * `starting` is `mount`. A source signal's initialiser is evaluated
#     once, when the document loads. Everything expensive is acquired
#     there — the context, the scene, the camera, one cylinder geometry
#     and two materials shared by every branch — and the compiler refuses
#     to let any of it be replaced: a handle may not be `from` (a derived
#     signal recomputes) and may not be written (a `set` would drop the
#     live object with nothing to release it). E0317 is that rule.
#
#   * `from` is `update`. The one derived signal below rebuilds the branch
#     meshes and draws a frame. Everything it makes is an ordinary
#     JavaScript object the collector will take; nothing it makes owns a
#     GPU resource, because the geometry and the materials were acquired
#     above and are only referenced here.
#
# So the leak the hand-written module existed to prevent is prevented by
# the placement rules instead, and the compiler is the thing that checks
# it rather than a comment at the top of a `.js` file.
#
# WHAT IS STILL NOT EXPRESSIBLE, HONESTLY. There is no effect construct —
# no statement runs at mount, and none runs on a schedule — so the redraw
# is written as a *derivation whose value is the branch count*. That is
# true of the function (it does count the branches it makes), and it is
# also the only position in the language a run of statements can be
# reached from when a signal changes. A language with an effect would say
# this in one line and would not need the count. There is no frame loop
# either, for the reason `examples/tree/tree.zd` gives: a signal that
# ticked sixty times a second is an animation and not state (#189).

# --- three.js, as classes ---------------------------------------------
#
# `gives new Handle` says the export is a class and the call constructs.
# A handle is opaque: the compiler knows nothing about one but what went
# into it, which is exactly what an object in the browser's own heap is.

foreign newRenderer is client
    from "three" as "WebGLRenderer"
    gives new Handle

foreign newScene is client
    from "three" as "Scene"
    gives new Handle

foreign newGroup is client
    from "three" as "Group"
    gives new Handle

foreign newCamera is client
    from "three" as "PerspectiveCamera"
    takes fov is Decimal, aspect is Decimal, near is Decimal, far is Decimal
    gives new Handle

foreign newCylinder is client
    from "three" as "CylinderGeometry"
    takes top is Decimal, bottom is Decimal, height is Decimal, sides is Whole
    gives new Handle

foreign newMaterial is client
    from "three" as "MeshStandardMaterial"
    gives new Handle

foreign newMesh is client
    from "three" as "Mesh"
    takes geometry is Handle, material is Handle
    gives new Handle

foreign newSkyLight is client
    from "three" as "HemisphereLight"
    takes above is Whole, below is Whole, strength is Decimal
    gives new Handle

foreign newSunLight is client
    from "three" as "DirectionalLight"
    takes colour is Whole, strength is Decimal
    gives new Handle

# --- what a host object has -------------------------------------------
#
# `of Handle as "x"` reads a property. It is member access and nothing
# else: `renderer.domElement` is a canvas, and `renderer.domElement()` is
# a TypeError.

foreign canvasOf is client
    of Handle as "domElement"
    takes of r is Handle
    gives Handle

foreign documentOf is client
    of Handle as "ownerDocument"
    takes of node is Handle
    gives Handle

foreign bodyOf is client
    of Handle as "body"
    takes of page is Handle
    gives Handle

foreign widthOf is client
    of Handle as "clientWidth"
    takes of node is Handle
    gives Whole

foreign positionOf is client
    of Handle as "position"
    takes of object is Handle
    gives Handle

foreign rotationOf is client
    of Handle as "rotation"
    takes of object is Handle
    gives Handle

foreign scaleOf is client
    of Handle as "scale"
    takes of object is Handle
    gives Handle

foreign colourOf is client
    of Handle as "color"
    takes of material is Handle
    gives Handle

# --- what a host object does ------------------------------------------
#
# `on Handle as "m"` calls a method. `gives nothing` says no ZDeceptron
# value comes back from it, which is the truth about the declaration
# whatever the host returns — `add` hands back the object for chaining and
# this program takes none of it. A call to one of these can only be
# written as a `do` statement, so nothing can read `undefined` as a value.

foreign attach is client
    on Handle as "appendChild"
    takes parent is Handle, child is Handle
    gives Handle

foreign addTo is client
    on Handle as "add"
    takes parent is Handle, child is Handle
    gives nothing

foreign emptyOut is client
    on Handle as "clear"
    takes of group is Handle
    gives nothing

foreign setTo is client
    on Handle as "set"
    takes vector is Handle, x is Decimal, y is Decimal, z is Decimal
    gives nothing

foreign setHex is client
    on Handle as "setHex"
    takes colour is Handle, value is Whole
    gives nothing

foreign setSize is client
    on Handle as "setSize"
    takes r is Handle, wide is Decimal, high is Decimal, restyle is Truth
    gives nothing

foreign setPixels is client
    on Handle as "setPixelRatio"
    takes r is Handle, ratio is Decimal
    gives nothing

foreign lookAt is client
    on Handle as "lookAt"
    takes eye is Handle, x is Decimal, y is Decimal, z is Decimal
    gives nothing

foreign drawInto is client
    on Handle as "render"
    takes r is Handle, world is Handle, eye is Handle
    gives nothing

# --- mount: acquired once, never replaced -----------------------------
#
# Every one of these is `client` and `starting`, which is the only shape
# that may hold a handle. The chain from `gl` to `screen` is the mount:
# the renderer makes its own canvas, the canvas knows the document it
# belongs to, and `appendChild` puts it in the page and hands it back.

state gl     is client Handle starting newRenderer
state canvas is client Handle starting (canvasOf of gl)
state page   is client Handle starting (documentOf of canvas)
state paper  is client Handle starting (bodyOf of page)
state screen is client Handle starting (attach with parent is paper, child is canvas)

state world  is client Handle starting newScene
state eye    is client Handle starting (
    newCamera with fov is 42.0,
    aspect is 1.714,
    near is 0.1,
    far is 100.0)
state canopy is client Handle starting newGroup

# One cylinder and two materials for every branch of every rebuild. These
# are the GPU resources: a buffer and two shader programs. Acquiring them
# here rather than in the derivation below is what makes a rebuild cheap
# and what keeps the driver from being asked for a new one per branch.
state stemShape is client Handle starting (
    newCylinder with top is 0.06,
    bottom is 0.09,
    height is 1.0,
    sides is 6)
state bark      is client Handle starting newMaterial
state sky       is client Handle starting (
    newSkyLight with above is 16777215,
    below is 3358767,
    strength is 1.15)
state sun       is client Handle starting (
    newSunLight with colour is 16777215,
    strength is 0.85)

# --- the two controls -------------------------------------------------

state depth  is client Whole starting 6
state spread is client Whole starting 3

state fan    is client Whole from clamp with value is spread, low is 1, high is 4
state levels is client Whole from clamp with value is depth, low is 1, high is 9

# --- where a branch points --------------------------------------------
#
# No trigonometry here either, and for the same reason `examples/tree/`
# needs none: a branch is a child *object* of the branch it grows from, so
# three.js composes the rotations on the way down exactly as the
# compositor does. What this program names is a branch's angle within its
# parent, and three.js turns that into a matrix.

function turnAngle with turn, fan
    give 6.2831853 * (decimalOf of turn) / (decimalOf of fan)

# The trunk stands up; everything above it leans away from what it grew
# from.
function leanFor of level
    if level <= 1
        give 0.0
    give 0.62

# --- update: rebuild the branches and draw a frame ---------------------

# One branch. A group at `rise` above its parent's origin, leaned and spun
# within it, carrying a cylinder of its own and whatever children the
# level allows. Gives back how many branches that came to, which is the
# number on the page.
function limbFrom with parent, level, levels, fan, turn, rise, length, thick
    with node is newGroup
    do addTo with parent is parent, child is node
    do setTo with vector is (positionOf of node), x is 0.0, y is rise, z is 0.0
    do setTo with vector is (rotationOf of node),
        x is 0.0,
        y is (turnAngle with turn is turn, fan is fan),
        z is (leanFor of level)

    with stem is (newMesh with geometry is stemShape, material is bark)
    do addTo with parent is node, child is stem
    do setTo with vector is (scaleOf of stem), x is thick, y is length, z is thick
    do setTo with vector is (positionOf of stem), x is 0.0, y is (length / 2.0), z is 0.0

    give 1 + (
        fanOut with parent is node,
        level is level + 1,
        levels is levels,
        fan is fan,
        index is 0,
        total is 0,
        rise is length,
        length is length * 0.72,
        thick is thick * 0.68)

# The children of one branch, one at a time, in tail position so the
# emitter turns the last call into a jump. Emptying the fan is what ends
# the recursion: past the last level there are no turns to take.
function fanOut with parent, level, levels, fan, index, total, rise, length, thick
    if level > levels
        give total
    if index >= fan
        give total
    give fanOut with parent is parent,
        level is level,
        levels is levels,
        fan is fan,
        index is index + 1,
        total is total + (
            limbFrom with parent is parent,
            level is level,
            levels is levels,
            fan is fan,
            turn is index,
            rise is rise,
            length is length,
            thick is thick),
        rise is rise,
        length is length,
        thick is thick

# The whole of the redraw, and the whole of what a frame costs.
#
# `emptyOut` detaches the previous rebuild's groups and meshes. They own
# nothing the collector cannot take: the geometry and the material they
# referenced are the ones acquired at mount and are still referenced from
# there.
function drawTree with levels, fan
    with wide is (decimalOf of (
        clamp with value is (widthOf of screen),
        low is 320,
        high is 1280))
    do setPixels with r is gl, ratio is 2.0
    do setSize with r is gl, wide is wide, high is (wide * 0.58), restyle is no

    do setHex with colour is (colourOf of bark), value is 7031610

    do setTo with vector is (positionOf of eye), x is 0.0, y is 2.0, z is 5.4
    do lookAt with eye is eye, x is 0.0, y is 1.9, z is 0.0

    do setTo with vector is (positionOf of sun), x is 4.0, y is 8.0, z is 5.0
    do addTo with parent is world, child is sky
    do addTo with parent is world, child is sun
    do addTo with parent is world, child is canopy

    do emptyOut of canopy
    with grown is (
        limbFrom with parent is canopy,
        level is 1,
        levels is levels,
        fan is fan,
        turn is 0,
        rise is 0.0,
        length is 1.0,
        thick is 1.0)
    do drawInto with r is gl, world is world, eye is eye
    give grown

state branches is client Whole from drawTree with levels is levels, fan is fan

# --- the page ---------------------------------------------------------
#
# The canvas is not in here. It is `appendChild`ed to the document's body
# by the mount chain above, because a `state` initialiser runs before the
# view is attached and there is nothing yet to attach it to — so
# `assets/webgl.css` is what places it, and it sits under the controls.

view title is "A tree in WebGL"
    Column class is "zw-page", font is "system", padding is 28, gap is 18
        Column gap is 6
            Heading "A tree in WebGL"
            Text "Real three.js, driven from ZDeceptron with no hand-written JavaScript. Every class is a foreign declaration; the WebGL context is acquired once, in state the compiler will not let anything replace; and one derivation rebuilds the branches and draws a frame.",
                color is "muted",
                size is "small",
                lineHeight is 1.55

        Row gap is 14, align is "stretch"
            Column grow is 1,
                basis is 0,
                gap is 10,
                padding is 14,
                radius is 14,
                background is "raised",
                border is 1,
                borderColor is "line"
                Text "levels", color is "muted", size is "small"
                Row gap is 8, align is "center"
                    Button "−",
                        padding is 6,
                        width is 38,
                        radius is 10,
                        background is "surface",
                        border is 1,
                        borderColor is "line",
                        color is "ink",
                        hoverBackground is "raised"
                        on click
                            if depth > 1
                                subtract 1 from depth
                    Button "+",
                        padding is 6,
                        width is 38,
                        radius is 10,
                        background is "surface",
                        border is 1,
                        borderColor is "line",
                        color is "ink",
                        hoverBackground is "raised"
                        on click
                            if depth < 9
                                add 1 to depth
                    Text levels, class is "zw-readout", size is "large", weight is "600"

            Column grow is 1,
                basis is 0,
                gap is 10,
                padding is 14,
                radius is 14,
                background is "raised",
                border is 1,
                borderColor is "line"
                Text "branches per fork", color is "muted", size is "small"
                Row gap is 8, align is "center"
                    Button "−",
                        padding is 6,
                        width is 38,
                        radius is 10,
                        background is "surface",
                        border is 1,
                        borderColor is "line",
                        color is "ink",
                        hoverBackground is "raised"
                        on click
                            if spread > 1
                                subtract 1 from spread
                    Button "+",
                        padding is 6,
                        width is 38,
                        radius is 10,
                        background is "surface",
                        border is 1,
                        borderColor is "line",
                        color is "ink",
                        hoverBackground is "raised"
                        on click
                            if spread < 4
                                add 1 to spread
                    Text fan, class is "zw-readout", size is "large", weight is "600"

        Row gap is 6, align is "center"
            Text "branches:", color is "muted", size is "small"
            Text branches, class is "zw-readout", size is "small", weight is "600"
