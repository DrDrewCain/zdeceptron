{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(view|when|each\\s+.+\\s+in\\s+.+|if\\s+.+|otherwise|on\\s+\\w+|function\\s+.+|record\\s+\\w+|choice\\s+\\w+|[A-Z]\\w*.*)$",
    "decreaseIndentPattern": "^\\s*(otherwise)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*#.*$",
      "action": { "indent": "none" }
    }
  ],
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*"
}
